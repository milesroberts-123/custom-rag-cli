"""SRA RNA-seq sample labeling with PECO, tissue, and germplasm categories."""

from snakemake.utils import min_version, validate

min_version("9.13")


configfile: "config/config.yaml"


conda: "envs/global.yaml"


import pandas as pd

validate(config, "schemas/config.schema.yaml")

SAMPLES = pd.read_table(config["samples"], dtype=str).set_index("run", drop=False)
validate(SAMPLES, "schemas/samples.schema.yaml")

if SAMPLES["run"].duplicated().any():
    raise ValueError("config sample sheet contains duplicate run accessions")

# Optional window batching: process the sheet in non-overlapping, ordered
# slices across invocations. The sheet stays the single source of truth and
# aggregate rescans it, so labels.tsv accumulates every completed run from
# all windows. Both keys unset means process the whole sheet.
BATCH_SIZE = int(config.get("batch_size") or 0)
BATCH_INDEX = int(config.get("batch_index") or 0)
if (BATCH_SIZE > 0) != (BATCH_INDEX > 0):
    raise ValueError("set both batch_size and batch_index for a window, or neither")
if BATCH_SIZE > 0:
    total_rows = len(SAMPLES)
    start = (BATCH_INDEX - 1) * BATCH_SIZE
    if start >= total_rows:
        raise ValueError(
            f"batch_index {BATCH_INDEX} starts past the end of the sheet "
            f"({total_rows} rows)"
        )
    end = min(start + BATCH_SIZE, total_rows)
    SAMPLES = SAMPLES.iloc[start:end]
    print(
        f"Batch window: rows {start + 1}-{end} of {total_rows} "
        f"({len(SAMPLES)} runs)"
    )
    max_requests = int(config.get("athrdb", {}).get("max_requests") or 0)
    if max_requests and len(SAMPLES) > max_requests:
        print(
            f"Warning: window has {len(SAMPLES)} runs but athrdb.max_requests "
            f"is {max_requests}; runs past the cap get retriable stubs that a "
            "later window must redo."
        )

RUNS = SAMPLES["run"].tolist()
SAMNS = sorted(set(SAMPLES["biosample"].tolist()))
PRJNAS = sorted(set(SAMPLES["bioproject"].tolist()))


include: "rules/common.smk"
include: "rules/fetch.smk"
include: "rules/paper.smk"
include: "rules/peco.smk"
include: "rules/rna.smk"
include: "rules/label.smk"
include: "rules/quant.smk"


rule all:
    default_target: True
    input:
        expand("results/chunks/rna_type/{chunk}.done", chunk=CHUNK_IDS),
        expand("results/chunks/tissue/{chunk}.done", chunk=CHUNK_IDS),
        expand("results/chunks/germplasm/{chunk}.done", chunk=CHUNK_IDS),
        expand("results/chunks/exposure/{chunk}.done", chunk=CHUNK_IDS),
        expand("results/chunks/study_condition/{chunk}.done", chunk=CHUNK_IDS),
        expand("results/metadata/bioproject/{prjna}.json", prjna=PRJNAS),
        expand("results/metadata/athrdb/{run}.json", run=RUNS),
        "results/labels.tsv",
        "results/labels.excluded.tsv",
